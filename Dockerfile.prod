# syntax=docker/dockerfile:1
# Production image: OpenGate plus Litestream for off-site SQLite backups.
# Postgres deployments ignore Litestream (see deploy/fly-prod/entrypoint.sh).
FROM golang:1.27.3 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X github.com/saief1/opengate/internal/server.Version=${VERSION}" -o /out/opengate ./cmd/opengate

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ARG LITESTREAM_VERSION=0.5.17
# https://github.com/benbjohnson/litestream/releases/download/v0.5.17/checksums.txt
ARG LITESTREAM_SHA256=cfb371176d164437ae869f8351cfde49bd1804ae71c61923f75c9cba9c9c006d
ADD https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-${LITESTREAM_VERSION}-linux-x86_64.tar.gz /tmp/litestream.tar.gz
RUN echo "${LITESTREAM_SHA256}  /tmp/litestream.tar.gz" | sha256sum -c - \
 && tar -C /usr/local/bin -xzf /tmp/litestream.tar.gz litestream \
 && rm /tmp/litestream.tar.gz \
 && chmod 755 /usr/local/bin/litestream
COPY --from=build /out/opengate /usr/local/bin/opengate
COPY deploy/fly-prod/entrypoint.sh /entrypoint.sh
COPY deploy/fly-prod/litestream.yml /etc/litestream.yml
RUN chmod 755 /entrypoint.sh \
 && mkdir -p /data && chown 65532:65532 /data
ENV OPENGATE_LISTEN=0.0.0.0:8080 \
    OPENGATE_DATABASE=/data/opengate.db \
    OPENGATE_ENV=production
VOLUME ["/data"]
EXPOSE 8080
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["/usr/local/bin/opengate", "healthcheck"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["serve", "-config", "/etc/opengate/cloud.yaml"]
