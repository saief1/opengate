# deploy/docker-compose.cloud.yml settings. Copy to deploy/.env and fill in.
# Never commit the real file.
OPENGATE_DOMAIN=cloud.example.com
POSTGRES_PASSWORD=             # openssl rand -hex 24
OPENGATE_ADMIN_TOKEN=          # opengate keygen
OPENGATE_MASTER_KEY=           # opengate keygen (back it up: provider keys are unreadable without it)
STRIPE_API_KEY=                # sk_test_... first, sk_live_... (or a restricted rk_live_...) at launch
STRIPE_WEBHOOK_SECRET=         # whsec_... from the webhook endpoint
STRIPE_PRICE_TEAM=             # price_... of the Team monthly price
