# Required secrets (generate with `opengate keygen`)
# OPENGATE_MASTER_KEY=...
# OPENGATE_ADMIN_TOKEN=...

# Optional provider keys (you can also add them encrypted via the dashboard/admin API)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# Optional Slack-compatible webhook for budget / kill-switch alerts
# OPENGATE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
