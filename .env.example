# OpenGate environment. Copy to .env (git-ignored) and fill in.
# NEVER commit real values. Generate the two required secrets with:
#   docker run --rm opengate keygen      (or: go run ./cmd/opengate keygen)

# ---- required ----
OPENGATE_MASTER_KEY=            # 32-byte base64; encrypts provider keys and MCP secrets (AES-256-GCM). Losing it = stored secrets unrecoverable.
OPENGATE_ADMIN_TOKEN=           # operator bearer token for the admin API / dashboard (>= 16 chars)

# ---- core ----
OPENGATE_LISTEN=0.0.0.0:8080
OPENGATE_DATABASE=/data/opengate.db           # SQLite path, or postgres://user:pass@host:5432/opengate?sslmode=require
# OPENGATE_CONFIG=/etc/opengate/opengate.yaml  # optional YAML config (secrets are env-only)
OPENGATE_LOG_FORMAT=json                      # json | text
OPENGATE_LOG_LEVEL=info                       # debug | info | warn | error
# OPENGATE_RATE_LIMIT_BACKEND=database        # database (shared across replicas) | memory
# OPENGATE_METRICS_TOKEN=                     # bearer token for /metrics
# OPENGATE_PUBLIC_URL=https://opengatehq.com   # required in cloud mode; Stripe return URL and email links
# OPENGATE_ENV=production                      # refuses demo flags; requires Postgres or LITESTREAM_BUCKET

# ---- plan / features ----
# OPENGATE_PLAN=                # empty = everything unlocked (self-hosted default); "free" locks Team features (audit viewer, roles, customer billing)

# ---- browser access to the gateway (/v1, /mcp) ----
# OPENGATE_CORS_ORIGINS=https://app.example.com   # comma separated; empty = no CORS (the admin API never sends CORS headers)

# ---- provider keys (optional; or store them encrypted in the dashboard) ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ---- alerts ----
# OPENGATE_ALERT_WEBHOOK_URL=   # Slack-compatible webhook (budget, kill switch, HTTP 5xx)

# ---- email (verification + password reset; unset = log only, no verification gate) ----
# RESEND_API_KEY=
# MAIL_FROM=OpenGate <noreply@opengatehq.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- SQLite off-site backups (Dockerfile.prod / deploy/fly-prod). Skip when OPENGATE_DATABASE is postgres:// ----
# LITESTREAM_BUCKET=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_ENDPOINT=
# LITESTREAM_REGION=
# LITESTREAM_FORCE_PATH_STYLE=true

# ---- Stripe (TEST MODE ONLY unless you opt in) ----
# STRIPE_API_KEY=               # sk_test_... / rk_test_... ; live keys are refused unless OPENGATE_STRIPE_ALLOW_LIVE=true
# STRIPE_WEBHOOK_SECRET=        # whsec_... (cloud mode)
# OPENGATE_STRIPE_ALLOW_LIVE=false

# ---- docker-compose.postgres.yml ----
# POSTGRES_PASSWORD=            # openssl rand -hex 16
